# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# impeccable design-review hook output (regenerated per session)
.impeccable/

# local-only reference docs, not meant for the shared repo
/PRODUCT.md
/docs/Framework-Structure/api-guide.md

# typescript
*.tsbuildinfo
next-env.d.ts
